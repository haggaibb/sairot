# IDE and OS files
.vscode/
*.iml
.DS_Store
Thumbs.db

# Generated files
*.g.dart
!lib/**/*.g.dart
lib/git_version.dart

# Hive database files (may contain sensitive data)
*.hive
*.lock

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
*~

# Firebase configuration files (contain API keys)
**/firebase_options.dart
lib/firebase_options.dart
